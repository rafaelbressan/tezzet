{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tezzet",
  "version": "0.1.0",
  "identifier": "rio.tezos.tezzet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tezzet — guardar",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Finance",
    "shortDescription": "Carteira Tezos",
    "longDescription": "Tezzet — carteira Tezos. Leitura da cadeia e conexão por Beacon; a assinatura acontece na carteira do usuário."
  }
}
