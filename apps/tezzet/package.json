{
  "name": "@tezosrio/tezzet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tezzet — carteira Tezos. Primeira onda: leitura e Beacon, sem custódia.",
  "scripts": {
    "chain:fetch": "node scripts/fetch-chain.mjs",
    "predev": "npm run chain:fetch",
    "dev": "vite",
    "prebuild": "npm run chain:fetch",
    "build": "tsc -b && vite build",
    "pretest": "npm run chain:fetch",
    "test": "vitest run",
    "typecheck": "tsc -b --force",
    "check:design": "node scripts/check-design-tokens.mjs",
    "verify": "npm run chain:fetch && npm run check:design && npm run typecheck && npm run test && npm run build",
    "tauri": "tauri",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ecadlabs/beacon-dapp": "^4.8.4-ecad",
    "@taquito/beacon-wallet": "^25.0.0",
    "@taquito/taquito": "^25.0.0",
    "@taquito/utils": "^25.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
