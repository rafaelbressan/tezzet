{
  "expo": {
    "name": "Tezzet",
    "slug": "tezzet",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "tezzet",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D61FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "rio.tezos.tezzet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tezzet uses Face ID to secure your wallet access.",
        "NSCameraUsageDescription": "Tezzet uses the camera to scan QR codes for receiving payments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D61FF"
      },
      "package": "rio.tezos.tezzet",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tezzet to access your camera for QR code scanning."
        }
      ],
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "owner": "tezosrio",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    }
  }
}
